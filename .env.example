# 复制到 server/.env 后按需填写。
# 约定：留空 = 未设置。所有可选能力在缺配置时自动禁用，不影响服务启动。

# 运行环境：development | test | production
NODE_ENV=development
# 后端监听端口
PORT=8787
# SQLite 文件路径（相对 server/prisma/）
DATABASE_URL=file:./dev.db

# ---- DeepSeek（阶段 2，必需）----
# 不填也能启动：AI 层会降级，条目停留在 pending 状态，服务不崩。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 模型名走配置，不硬编码：DeepSeek 在 2026 年变更过模型 ID
DEEPSEEK_MODEL_FAST=deepseek-flash
DEEPSEEK_MODEL_SMART=deepseek-v4-pro
# 置 1 时 AI 层返回固定结果，用于离线测试
AI_MOCK=0
# 每日 token 预算上限，超出后降级为只跑 L0 + L1
AI_DAILY_TOKEN_BUDGET=200000

# ---- Agent API（阶段 8）----
# 为空则 /api/agent/* 整个禁用
AI_HOT_TOKEN=

# ---- 通知渠道（阶段 4），全为可选 ----
# 为空则对应渠道自动禁用
SMTP_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ---- 可选数据源（阶段 6）----
TWITTERAPI_IO_KEY=
FIRECRAWL_API_KEY=

LOG_LEVEL=info
